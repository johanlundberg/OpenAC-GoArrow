<?xml version="1.0" encoding="utf-8"?>
<panel x="0" y="0" w="360" h="585" title="GoArrow" resizable="true" minw="300" minh="585">
  <group x="8" y="8" w="344" h="196" border="#FF4A3A14">
    <label x="8" y="8" text="From" />
    <field x="8" y="26" w="250" h="20" text="{FromEditorInput}" onchange="{UpdateFromInputAction}" onsubmit="{SubmitFromTextAction}" visible="{FromEditorVisible}" />
    <button x="8" y="26" w="250" h="20" text="{FromInput}" onclick="{EditFromAction}" visible="{FromSelectionVisible}" />
    <button x="266" y="26" w="70" h="20" text="Set" onclick="{SubmitFromAction}" />
    <label x="8" y="52" text="Destination" />
    <field x="8" y="70" w="250" h="20" text="{DestinationInput}" onchange="{UpdateDestinationInputAction}" onsubmit="{SubmitDestinationTextAction}" visible="{DestinationEditorVisible}" />
    <button x="8" y="70" w="250" h="20" text="{DestinationInput}" onclick="{EditDestinationAction}" visible="{DestinationSelectionVisible}" />
    <button x="266" y="70" w="70" h="20" text="Set" onclick="{SubmitDestinationAction}" />
    <label x="8" y="96" text="{SearchResultsLabel}" visible="{SearchResultsVisible}" />
    <list x="8" y="112" w="328" h="72" rowheight="18" items="{SearchResults}" selected="{SelectedSearchResult}" onchange="{SelectSearchResultAction}" visible="{SearchResultsVisible}" selectionband="true" />
  </group>

  <group x="8" y="212" w="344" h="72" border="#FF4A3A14">
    <button x="8" y="8" w="72" h="22" text="Go" enabled="{HasDestination}" onclick="{StartNavigation}" />
    <button x="88" y="8" w="72" h="22" text="Stop" enabled="{IsNavigating}" onclick="{StopNavigation}" />
    <button x="168" y="8" w="80" h="22" text="Resume" enabled="{WaitingForInteraction}" onclick="{ResumeNavigation}" />
    <button x="256" y="8" w="80" h="22" text="Clear" enabled="{HasDestination}" onclick="{ClearDestination}" />
    <label x="8" y="40" text="Route:" />
    <label x="52" y="40" text="{RouteStepsText}" />
    <label x="120" y="40" text="{FromText}" />
  </group>

  <group x="8" y="292" w="344" h="160" border="#FF4A3A14">
    <label x="8" y="8" text="Route steps" />
    <label x="88" y="8" text="{NextTargetText}" />
    <list x="8" y="32" w="328" h="120" rowheight="18" items="{RouteSteps}" selected="{SelectedRouteStep}" selectionband="true" />
  </group>

  <group x="8" y="460" w="344" h="112" border="#FF4A3A14">
    <label x="8" y="8" text="Display" />
    <toggle x="8" y="30" w="150" h="20" text="Show Distance" checked="{ShowDistance}" onclick="{ToggleShowDistance}" />
    <toggle x="170" y="30" w="150" h="20" text="Show Bearing" checked="{ShowBearing}" onclick="{ToggleShowBearing}" />
    <toggle x="8" y="56" w="150" h="20" text="Auto-Navigate" checked="{AutoNavigate}" onclick="{ToggleAutoNavigate}" />
    <toggle x="170" y="56" w="150" h="20" text="Recalculate" checked="{RecalculateRoute}" onclick="{ToggleRecalculateRoute}" />
    <toggle x="8" y="84" w="160" h="20" text="Dungeon Map" checked="{DungeonMapVisible}" onclick="{ToggleDungeonMap}" />
    <label x="176" y="84" text="Auto-show indoors" />
  </group>
</panel>
