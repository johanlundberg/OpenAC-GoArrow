<?xml version="1.0" encoding="utf-8"?>
<panel x="0" y="0" w="560" h="625" resizable="true" minw="360" minh="625">
  <label x="8" y="4" text="{TitleText}" />
  <tab x="8" y="8" w="84" h="26" text="Route" selected="{RouteTabSelected}" onclick="{ShowRouteTab}" />
  <tab x="96" y="8" w="84" h="26" text="Config" selected="{ConfigTabSelected}" onclick="{ShowConfigTab}" />
  <tab x="184" y="8" w="84" h="26" text="Details" selected="{DetailsTabSelected}" onclick="{ShowDetailsTab}" />

  <group x="8" y="42" w="544" h="196" anchor="left right top" border="#FF4A3A14" visible="{RouteTabVisible}">
    <label x="8" y="8" text="From" />
    <field x="8" y="26" w="450" h="20" anchor="left right top" text="{FromEditorInput}" onchange="{UpdateFromInputAction}" onsubmit="{SubmitFromTextAction}" visible="{FromEditorVisible}" />
    <button x="8" y="26" w="450" h="20" anchor="left right top" text="{FromInput}" onclick="{EditFromAction}" visible="{FromSelectionVisible}" />
    <button x="466" y="26" w="70" h="20" anchor="right top" text="Set" onclick="{SubmitFromAction}" />
    <label x="8" y="52" text="Destination" />
    <field x="8" y="70" w="450" h="20" anchor="left right top" text="{DestinationInput}" onchange="{UpdateDestinationInputAction}" onsubmit="{SubmitDestinationTextAction}" visible="{DestinationEditorVisible}" />
    <button x="8" y="70" w="450" h="20" anchor="left right top" text="{DestinationInput}" onclick="{EditDestinationAction}" visible="{DestinationSelectionVisible}" />
    <button x="466" y="70" w="70" h="20" anchor="right top" text="Set" onclick="{SubmitDestinationAction}" />
    <label x="8" y="96" text="{SearchResultsLabel}" visible="{SearchResultsVisible}" />
    <list x="8" y="112" w="528" h="72" anchor="left right top" rowheight="18" items="{SearchResults}" selected="{SelectedSearchResult}" onchange="{SelectSearchResultAction}" visible="{SearchResultsVisible}" selectionband="true" />
  </group>

  <group x="8" y="246" w="544" h="72" anchor="left right top" border="#FF4A3A14" visible="{RouteTabVisible}">
    <button x="8" y="8" w="72" h="22" text="Go" enabled="{HasDestination}" onclick="{StartNavigation}" />
    <button x="88" y="8" w="72" h="22" text="Stop" enabled="{IsNavigating}" onclick="{StopNavigation}" />
    <button x="168" y="8" w="80" h="22" text="Resume" enabled="{WaitingForInteraction}" onclick="{ResumeNavigation}" />
    <button x="256" y="8" w="80" h="22" text="Clear" enabled="{HasDestination}" onclick="{ClearDestination}" />
    <label x="344" y="12" text="{NavStatusText}" />
    <label x="8" y="40" text="Route:" />
    <label x="52" y="40" text="{RouteStepsText}" />
    <label x="120" y="40" text="{FromText}" />
  </group>

  <group x="8" y="326" w="544" h="160" anchor="left right top bottom" border="#FF4A3A14" visible="{RouteTabVisible}">
    <label x="8" y="8" text="Route steps" />
    <label x="88" y="8" text="{NextTargetText}" />
    <list x="8" y="32" w="528" h="120" anchor="left right top bottom" rowheight="18" items="{RouteSteps}" selected="{SelectedRouteStep}" onchange="{SelectRouteStepAction}" selectionband="true" />
  </group>

  <group x="8" y="494" w="544" h="112" anchor="left right bottom" border="#FF4A3A14" visible="{RouteTabVisible}">
    <label x="8" y="8" text="Display" />
    <toggle x="8" y="30" w="150" h="20" text="Show Distance" checked="{ShowDistance}" onclick="{ToggleShowDistance}" />
    <toggle x="170" y="30" w="150" h="20" text="Show Bearing" checked="{ShowBearing}" onclick="{ToggleShowBearing}" />
    <toggle x="8" y="56" w="150" h="20" text="Auto-Navigate" checked="{AutoNavigate}" onclick="{ToggleAutoNavigate}" />
    <toggle x="170" y="56" w="150" h="20" text="Recalculate" checked="{RecalculateRoute}" onclick="{ToggleRecalculateRoute}" />
    <toggle x="8" y="84" w="160" h="20" text="Dungeon Map" checked="{DungeonMapVisible}" onclick="{ToggleDungeonMap}" />
  </group>

  <group x="8" y="42" w="544" h="146" anchor="left right top" border="#FF4A3A14" visible="{ConfigTabVisible}">
    <label x="8" y="8" text="Location data URL" />
    <field x="8" y="30" w="528" h="22" anchor="left right top" maxlength="1024" text="{LocationDataUrlInput}" onchange="{UpdateLocationDataUrlAction}" onsubmit="{SubmitLocationDataUrlAction}" />
    <button x="8" y="62" w="90" h="24" text="Save URL" onclick="{SaveLocationDataUrlAction}" />
    <button x="106" y="62" w="100" h="24" text="Download" onclick="{DownloadLocationDataAction}" />
    <label x="8" y="96" text="{LocationDownloadStatus}" />
  </group>

  <group x="8" y="196" w="544" h="170" anchor="left right top" border="#FF4A3A14" visible="{ConfigTabVisible}">
    <label x="8" y="8" text="Dungeon map ZIP URL" />
    <field x="8" y="30" w="528" h="22" anchor="left right top" maxlength="1024" text="{DungeonMapUrlInput}" onchange="{UpdateDungeonMapUrlAction}" onsubmit="{SubmitDungeonMapUrlAction}" />
    <button x="8" y="62" w="90" h="24" text="Save URL" onclick="{SaveDungeonMapUrlAction}" />
    <button x="106" y="62" w="100" h="24" text="Download" onclick="{DownloadDungeonMapsAction}" />
    <label x="8" y="96" text="{DungeonDownloadStatus}" />
    <label x="8" y="128" text="Extracted maps take precedence over the ZIP." />
  </group>

  <group x="8" y="374" w="544" h="100" anchor="left right top" border="#FF4A3A14" visible="{ConfigTabVisible}">
    <label x="8" y="8" text="Overlays" />
    <toggle x="8" y="32" w="150" h="20" text="Show Arrow" checked="{ArrowVisible}" onclick="{ToggleArrowVisible}" />
    <toggle x="170" y="32" w="150" h="20" text="Show Toolbar" checked="{ToolbarVisible}" onclick="{ToggleToolbarVisible}" />
    <button x="8" y="64" w="180" h="24" text="Reset overlay positions" onclick="{ResetOverlayPositionsAction}" />
  </group>

  <group x="8" y="42" w="544" h="565" anchor="left right top bottom" border="#FF4A3A14" visible="{DetailsTabVisible}">
    <label x="8" y="8" text="{DetailsStepNumberText}" />
    <button x="420" y="6" w="116" h="24" anchor="right top" text="Back to route" onclick="{ShowRouteTab}" />
    <label x="8" y="38" text="{DetailsInstructionText}" />
    <label x="8" y="72" text="Location" />
    <label x="100" y="72" text="{DetailsLocationName}" />
    <label x="8" y="96" text="Type" />
    <label x="100" y="96" text="{DetailsLocationType}" />
    <label x="8" y="120" text="Coordinates" />
    <label x="100" y="120" text="{DetailsCoordinates}" />
    <label x="8" y="144" text="Arrival" visible="{DetailsArrivalVisible}" />
    <label x="100" y="144" text="{DetailsArrivalCoordinates}" visible="{DetailsArrivalVisible}" />
    <label x="8" y="168" text="Walk distance" visible="{DetailsDistanceVisible}" />
    <label x="100" y="168" text="{DetailsDistance}" visible="{DetailsDistanceVisible}" />
    <label x="8" y="200" text="Notes" />
    <list x="8" y="224" w="528" h="329" anchor="left right top bottom" rowheight="18" items="{DetailsNotesLines}" selected="{SelectedNotesLine}" />
  </group>
</panel>
