<?xml version="1.0" encoding="utf-8"?>
<panel x="0" y="0" w="360" h="485" title="GoArrow" resizable="true" minw="300" minh="485">
  <group x="8" y="8" w="344" h="110" border="#FF4A3A14">
    <label x="8" y="8" text="Destination" />
    <field x="8" y="28" w="250" h="20" text="{DestinationInput}" onchange="{UpdateDestinationInputAction}" onsubmit="{SubmitDestinationTextAction}" />
    <button x="266" y="28" w="78" h="20" text="Set" onclick="{SubmitDestinationAction}" />
    <label x="8" y="56" text="{DestinationText}" />
    <label x="8" y="76" text="Distance:" />
    <label x="62" y="76" text="{DistanceText}" />
    <label x="180" y="76" text="Bearing:" />
    <label x="238" y="76" text="{BearingText}" />
    <label x="8" y="94" text="Status:" />
    <label x="62" y="94" text="{NavStatusText}" />
  </group>

  <group x="8" y="126" w="344" h="64" border="#FF4A3A14">
    <button x="8" y="8" w="72" h="22" text="Go" enabled="{HasDestination}" onclick="{StartNavigation}" />
    <button x="88" y="8" w="72" h="22" text="Stop" enabled="{IsNavigating}" onclick="{StopNavigation}" />
    <button x="168" y="8" w="80" h="22" text="Resume" enabled="{WaitingForInteraction}" onclick="{ResumeNavigation}" />
    <button x="256" y="8" w="80" h="22" text="Clear" enabled="{HasDestination}" onclick="{ClearDestination}" />
    <label x="8" y="40" text="Route:" />
    <label x="52" y="40" text="{RouteStepsText}" />
  </group>

  <group x="8" y="198" w="344" h="160" border="#FF4A3A14">
    <label x="8" y="8" text="Route steps" />
    <label x="88" y="8" text="{NextTargetText}" />
    <list x="8" y="32" w="328" h="120" rowheight="18" items="{RouteSteps}" selected="{SelectedRouteStep}" selectionband="true" />
  </group>

  <group x="8" y="366" w="344" h="112" border="#FF4A3A14">
    <label x="8" y="8" text="Display" />
    <toggle x="8" y="30" w="150" h="20" text="Show Distance" checked="{ShowDistance}" onclick="{ToggleShowDistance}" />
    <toggle x="170" y="30" w="150" h="20" text="Show Bearing" checked="{ShowBearing}" onclick="{ToggleShowBearing}" />
    <toggle x="8" y="56" w="150" h="20" text="Auto-Navigate" checked="{AutoNavigate}" onclick="{ToggleAutoNavigate}" />
    <toggle x="170" y="56" w="150" h="20" text="Recalculate" checked="{RecalculateRoute}" onclick="{ToggleRecalculateRoute}" />
    <toggle x="8" y="84" w="160" h="20" text="Dungeon Map" checked="{DungeonMapVisible}" onclick="{ToggleDungeonMap}" />
    <label x="176" y="84" text="Auto-show indoors" />
  </group>
</panel>
