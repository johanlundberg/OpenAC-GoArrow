<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>AcDream.Plugins.GoArrow</RootNamespace>
    <!-- The release version is passed as PluginVersion, never as a global
         Version: a global -p:Version also renames the referenced
         AcDream.Plugin.Abstractions build, and a plugin that asks for an
         API assembly version the client does not ship never loads
         ("no IAcDreamPlugin implementation found"). Only this project
         takes the release version. -->
    <Version Condition="'$(PluginVersion)' != ''">$(PluginVersion)</Version>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AcDream.Plugins.GoArrow.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(OpenAcDir)/src/AcDream.Plugin.Abstractions/AcDream.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
      <!-- Release publishing passes Version for this plugin. Do not propagate
           that plugin version into the host contract project: otherwise the
           plugin records a dependency on (for example) 1.0.2.0 while the host
           supplies AcDream.Plugin.Abstractions 0.1.15. -->
      <GlobalPropertiesToRemove>Version</GlobalPropertiesToRemove>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Update="plugin.json;goarrow-panel.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="EmbeddedResources/DefaultLocations.xml" />
    <EmbeddedResource Include="EmbeddedResources/DefaultPortalDevices.xml" />
    <EmbeddedResource Include="EmbeddedResources/DefaultRouteStarts.xml" />
  </ItemGroup>
</Project>
